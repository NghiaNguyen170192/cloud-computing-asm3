@page "/"

<section class="hero">
    <h1>Give where it helps most</h1>
    <p class="lead mb-4">Support community programmes with a simulated donation. No card is charged.</p>
    <a class="btn btn-lg btn-light" href="donate">Make a donation</a>
</section>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card-panel h-100">
            <h3>1. Tell us who you are</h3>
            <p class="mb-0">We record a contact so receipts and later messages can reach you.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-panel h-100">
            <h3>2. Choose an amount</h3>
            <p class="mb-0">Pick a gift amount and a simulated payment method. Nothing is billed.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-panel h-100">
            <h3>3. Get a receipt</h3>
            <p class="mb-0">We post a transaction, write a journal line, and store a digital PDF.</p>
        </div>
    </div>
</div>
