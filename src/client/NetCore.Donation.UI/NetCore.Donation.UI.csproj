<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>12102da9-c1e7-4e66-bdd6-5d1bc0ecbdce</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..</DockerfileContext>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
		<IsAspireProjectResource>true</IsAspireProjectResource>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NetCore.Donation.WebClient\NetCore.Donation.WebClient.csproj" />
		<ProjectReference Include="..\..\NetCore.Donation.ServiceDefaults\NetCore.Donation.ServiceDefaults.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="Properties\launchSettings.json" CopyToPublishDirectory="Never" />
		<None Include="Procfile" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
