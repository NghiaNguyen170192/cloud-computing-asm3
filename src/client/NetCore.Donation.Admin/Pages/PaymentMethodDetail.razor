@page "/payment-methods/new"
@page "/payment-methods/{Id:guid}"
@inject DonationApiClient Api
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "New payment method" : "Payment method") — Donation admin</PageTitle>

<EntityFormBar Title="@(IsNew ? "New payment method" : "Payment method")"
               Busy="@saving"
               ShowSave="@IsNew"
               Save="@SaveAsync"
               Back="@(() => Nav.NavigateTo("payment-methods"))" />

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (loading)
{
    <p>Loading…</p>
}
else if (!IsNew && missing)
{
    <p class="text-muted">Payment method not found.</p>
}
else
{
    <div class="detail-card">
        <DetailGrid>
            <DetailField Label="Contact" Locked="@(!IsNew)">
                <ContactLookup @bind-ContactId="form.ContactId" Label="@form.ContactName" Disabled="@(!IsNew)" />
            </DetailField>
            <DetailField Label="Display name" Locked="@(!IsNew)"><input class="form-control" @bind="form.DisplayName" disabled="@(!IsNew)" /></DetailField>
            <DetailField Label="Payment type" Locked="@(!IsNew)">
                <select class="form-select" @bind="form.PaymentType" disabled="@(!IsNew)">
                    @foreach (var type in Enum.GetValues<PaymentType>())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </DetailField>
        </DetailGrid>
    </div>
    @if (!IsNew)
    {
        <div class="related-stack">
            <RelatedPaymentSchedules PaymentMethodId="Id" />
            <RelatedTransactions PaymentMethodId="Id" />
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool IsNew => Id == Guid.Empty;

    private bool loading;
    private bool saving;
    private bool missing;
    private string? error;
    private MethodForm form = new();

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew)
        {
            form = new MethodForm();
            loading = false;
            missing = false;
            error = null;
            return;
        }

        loading = true;
        try
        {
            var item = await Api.GetPaymentMethodAsync(Id);
            if (item is null)
            {
                missing = true;
                return;
            }

            form = MethodForm.From(item);
            missing = false;
            error = null;
        }
        catch (Exception exception)
        {
            error = exception.Message;
            missing = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            if (IsNew && form.ContactId == Guid.Empty)
            {
                error = "Search for and select a contact.";
                return;
            }

            if (IsNew)
            {
                var id = await Api.CreatePaymentMethodAsync(form.ContactId, form.DisplayName, form.PaymentType);
                Nav.NavigateTo($"payment-methods/{id}");
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private sealed class MethodForm
    {
        public Guid ContactId { get; set; }
        public string? ContactName { get; set; }
        public string DisplayName { get; set; } = string.Empty;
        public PaymentType PaymentType { get; set; } = PaymentType.Bank;

        public static MethodForm From(PaymentMethodDto item) => new()
        {
            ContactId = item.ContactId,
            ContactName = item.ContactFullName,
            DisplayName = item.DisplayName,
            PaymentType = item.PaymentType,
        };
    }
}
