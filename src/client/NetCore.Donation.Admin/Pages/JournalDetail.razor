@page "/journals/new"
@page "/journals/{Id:guid}"
@inject DonationApiClient Api
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "New journal" : "Journal") — Donation admin</PageTitle>

<EntityFormBar Title="@(IsNew ? "New journal" : "Journal")"
               Busy="@saving"
               ShowSave="@IsNew"
               Save="@SaveAsync"
               Back="@(() => Nav.NavigateTo("journals"))" />

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (loading)
{
    <p>Loading…</p>
}
else if (!IsNew && missing)
{
    <p class="text-muted">Journal not found.</p>
}
else
{
    <div class="detail-card">
        <DetailGrid>
            @if (!IsNew)
            {
                <DetailField Label="Identifier" Locked>@form.Identifier</DetailField>
                <DetailField Label="Created (UTC)" Locked>@form.CreatedUtc</DetailField>
                <DetailField Label="Modified (UTC)" Locked>@form.ModifiedUtc</DetailField>
            }
            <DetailField Label="Transaction" Locked="@(!IsNew)">
                <TransactionLookup ContactId="Guid.Empty"
                                   RequireContact="false"
                                   @bind-TransactionId="form.TransactionId"
                                   Label="@form.TransactionName"
                                   Disabled="@(!IsNew)" />
            </DetailField>
        </DetailGrid>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool IsNew => Id == Guid.Empty;

    private bool loading;
    private bool saving;
    private bool missing;
    private string? error;
    private JournalForm form = new();

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew)
        {
            form = new JournalForm();
            loading = false;
            missing = false;
            error = null;
            return;
        }

        loading = true;
        try
        {
            var item = await Api.GetJournalAsync(Id);
            if (item is null)
            {
                missing = true;
                return;
            }

            form = JournalForm.From(item);
            missing = false;
            error = null;
        }
        catch (Exception exception)
        {
            error = exception.Message;
            missing = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            if (form.TransactionId == Guid.Empty)
            {
                error = "Search for and select a transaction.";
                return;
            }

            var id = await Api.CreateJournalAsync(form.TransactionId);
            Nav.NavigateTo($"journals/{id}");
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private sealed class JournalForm
    {
        public string Identifier { get; set; } = string.Empty;
        public string CreatedUtc { get; set; } = string.Empty;
        public string ModifiedUtc { get; set; } = string.Empty;
        public Guid TransactionId { get; set; }
        public string? TransactionName { get; set; }

        public static JournalForm From(JournalDto item) => new()
        {
            Identifier = RadzenODataQuery.IdentifierOrShort(item.Identifier, item.Id),
            CreatedUtc = item.CreatedDate.ToString("u"),
            ModifiedUtc = item.ModifiedDate.ToString("u"),
            TransactionId = item.TransactionId,
            TransactionName = RadzenODataQuery.IdentifierOrShort(item.TransactionIdentifier, item.TransactionId),
        };
    }
}
