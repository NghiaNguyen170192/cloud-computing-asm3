@page "/contacts/new"
@page "/contacts/{Id:guid}"
@inject DonationApiClient Api
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "New contact" : "Contact") — Donation admin</PageTitle>

<EntityFormBar Title="@(IsNew ? "New contact" : "Contact")" Busy="@saving" Save="@SaveAsync" Back="@(() => Nav.NavigateTo("contacts"))" />

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (loading)
{
    <p>Loading…</p>
}
else if (!IsNew && missing)
{
    <p class="text-muted">Contact not found.</p>
}
else
{
    <div class="detail-card">
        <DetailGrid>
            <DetailField Label="First name"><input class="form-control" @bind="form.FirstName" /></DetailField>
            <DetailField Label="Last name"><input class="form-control" @bind="form.LastName" /></DetailField>
            <DetailField Label="Email"><input class="form-control" type="email" @bind="form.Email" /></DetailField>
            <DetailField Label="Gender">
                <select class="form-select" @bind="form.Gender">
                    @foreach (var gender in Enum.GetValues<Gender>())
                    {
                        <option value="@gender">@gender</option>
                    }
                </select>
            </DetailField>
            <DetailField Label="Phone"><input class="form-control" @bind="form.PhoneNumber" /></DetailField>
            <DetailField Label="Date of birth"><input class="form-control" type="date" @bind="form.DateOfBirth" /></DetailField>
            <DetailField Label="Address"><input class="form-control" @bind="form.AddressLine" /></DetailField>
            <DetailField Label="Country">
                <CountryLookup @bind-CountryId="form.CountryId" Label="@form.CountryName" />
            </DetailField>
            @if (!IsNew)
            {
                <DetailField Label="Active" Plain>
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" id="contact-active" @bind="form.IsActive" />
                        <label class="form-check-label" for="contact-active">Active</label>
                    </div>
                </DetailField>
            }
            <DetailField Label="Do not Email" Plain>
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="contact-do-not-email" @bind="form.DoNotEmail" />
                </div>
            </DetailField>
            <DetailField Label="Do not SMS" Plain>
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="contact-do-not-sms" @bind="form.DoNotSms" />
                </div>
            </DetailField>
        </DetailGrid>
    </div>
    @if (!IsNew)
    {
        <div class="related-stack">
            <RelatedPaymentMethods ContactId="Id" />
            <RelatedPaymentSchedules ContactId="Id" />
            <RelatedTransactions ContactId="Id" />
            <RelatedReceipts ContactId="Id" />
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool IsNew => Id == Guid.Empty;

    private bool loading;
    private bool saving;
    private bool missing;
    private string? error;
    private ContactForm form = new();

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew)
        {
            form = new ContactForm();
            loading = false;
            missing = false;
            error = null;
            return;
        }

        loading = true;
        try
        {
            var item = await Api.GetContactAsync(Id);
            if (item is null)
            {
                missing = true;
                return;
            }

            form = ContactForm.From(item);
            missing = false;
            error = null;
        }
        catch (Exception exception)
        {
            error = exception.Message;
            missing = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            if (form.CountryId == Guid.Empty)
            {
                error = "Search for and select a country.";
                return;
            }

            if (IsNew)
            {
                var id = await Api.CreateContactAsync(
                    form.FirstName,
                    form.LastName,
                    form.DateOfBirth,
                    form.AddressLine,
                    form.Email,
                    form.PhoneNumber,
                    form.CountryId,
                    form.Gender,
                    form.DoNotEmail,
                    form.DoNotSms);
                Nav.NavigateTo($"contacts/{id}");
                return;
            }

            await Api.UpdateContactAsync(
                Id,
                form.FirstName,
                form.LastName,
                form.DateOfBirth,
                form.AddressLine,
                form.Email,
                form.PhoneNumber,
                form.CountryId,
                form.Gender,
                form.DoNotEmail,
                form.DoNotSms);
            await Api.SetContactActiveAsync(Id, form.IsActive);
            error = null;
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private sealed class ContactForm
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public DateOnly DateOfBirth { get; set; } = new(1990, 1, 1);
        public string AddressLine { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public Guid CountryId { get; set; }
        public string? CountryName { get; set; }
        public Gender Gender { get; set; } = Gender.Other;
        public bool IsActive { get; set; } = true;
        public bool DoNotEmail { get; set; }
        public bool DoNotSms { get; set; }

        public static ContactForm From(ContactDto item) => new()
        {
            FirstName = item.FirstName,
            LastName = item.LastName,
            DateOfBirth = item.DateOfBirth,
            AddressLine = item.AddressLine,
            Email = item.Email,
            PhoneNumber = item.PhoneNumber,
            CountryId = item.CountryId,
            CountryName = item.CountryName,
            Gender = item.Gender,
            IsActive = item.IsActive,
            DoNotEmail = item.DoNotEmail,
            DoNotSms = item.DoNotSms,
        };
    }
}
