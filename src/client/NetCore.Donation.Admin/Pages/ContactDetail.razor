@page "/contacts/{Id:guid}"
@inject DonationApiClient Api
@inject NavigationManager Nav

<PageTitle>Contact — Donation admin</PageTitle>

<div class="d-flex align-items-center gap-3 mb-3">
    <h1 class="mb-0">Contact</h1>
    <RadzenButton Text="Back to list" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => Nav.NavigateTo("contacts"))" />
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (loading)
{
    <p>Loading…</p>
}
else if (item is null)
{
    <p class="text-muted">Contact not found.</p>
}
else
{
    <div class="detail-card">
        <DetailGrid>
            <DetailField Label="Name">@item.DisplayName</DetailField>
            <DetailField Label="First name">@item.FirstName</DetailField>
            <DetailField Label="Last name">@item.LastName</DetailField>
            <DetailField Label="Email">@item.Email</DetailField>
            <DetailField Label="Gender">@item.Gender</DetailField>
            <DetailField Label="Phone">@item.PhoneNumber</DetailField>
            <DetailField Label="Date of birth">@item.DateOfBirth</DetailField>
            <DetailField Label="Address">@item.AddressLine</DetailField>
            <DetailField Label="Country">@item.CountryName</DetailField>
            <DetailField Label="Active">@item.IsActive</DetailField>
            <DetailField Label="Email preference">@(item.DoNotEmail ? "Do not email" : "Email allowed")</DetailField>
            <DetailField Label="SMS preference">@(item.DoNotSms ? "Do not SMS" : "SMS allowed")</DetailField>
        </DetailGrid>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool loading = true;
    private string? error;
    private ContactDto? item;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            item = await Api.GetContactAsync(Id);
            error = null;
        }
        catch (Exception exception)
        {
            error = exception.Message;
            item = null;
        }
        finally
        {
            loading = false;
        }
    }
}
