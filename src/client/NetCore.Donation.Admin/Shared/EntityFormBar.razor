<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <h1 class="mb-0">@Title</h1>
    @if (ShowSave)
    {
        <RadzenButton Text="Save" Click="@Save" Disabled="@Busy" Size="ButtonSize.Small" />
    }
    <RadzenButton Text="Back to list" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@Back" Disabled="@Busy" />
</div>

@code {
    [Parameter] public string Title { get; set; } = "";

    [Parameter] public bool Busy { get; set; }

    [Parameter] public bool ShowSave { get; set; } = true;

    [Parameter] public EventCallback Save { get; set; }

    [Parameter] public EventCallback Back { get; set; }
}
