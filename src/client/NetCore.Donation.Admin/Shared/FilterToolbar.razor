<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap"
             class="rz-p-3 rz-border-radius-1" Style="border: var(--rz-grid-cell-border);">
    @if (Add.HasDelegate)
    {
        <RadzenButton Text="@AddText" Click="@Add" Size="ButtonSize.Small" />
    }
    <RadzenButton Text="Apply Filter" Click="@Apply" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" />
    <span class="text-muted small">Each view loads the top 20 records. Apply a filter to search.</span>
</RadzenStack>

@code {
    [Parameter] public EventCallback Apply { get; set; }

    [Parameter] public EventCallback Add { get; set; }

    [Parameter] public string AddText { get; set; } = "Add";
}
