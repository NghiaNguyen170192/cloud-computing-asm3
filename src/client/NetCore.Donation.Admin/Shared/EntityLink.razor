@if (Id is { } id && id != Guid.Empty)
{
    <a class="entity-link" href="@($"{Path.Trim('/')}/{id}")">@Display</a>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    [Parameter] public string? Text { get; set; }

    [Parameter] public string Path { get; set; } = "";

    private string Display => string.IsNullOrWhiteSpace(Text)
        ? RadzenODataQuery.ShortId(Id)
        : Text;
}
